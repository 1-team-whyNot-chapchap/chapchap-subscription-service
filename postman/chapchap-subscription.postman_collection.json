  "item": [
    {
      "name": "SUB-FN-003",
      "item": [
        {
          "name": "00 Setup - 테스트 고객 결제수단 탐색",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}", "type": "text" },
              { "key": "X-User-Role", "value": "{{testUserRole}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/subscription/payment-methods",
            "description": "테스트 고객의 최초 현재 수단과 선택 대상 비현재 수단을 찾는다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: 목록 조회가 성공한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const methods = body && body.data && Array.isArray(body.data.paymentMethods)",
                  "  ? body.data.paymentMethods",
                  "  : [];",
                  "const currentMethods = methods.filter(method => method.isCurrent === true);",
                  "const targetMethod = methods.find(method => method.isCurrent === false);",
                  "",
                  "pm.test('Setup: 테스트 고객에게 현재 수단이 정확히 하나 존재한다', function () {",
                  "  pm.expect(currentMethods.length).to.eql(1);",
                  "});",
                  "pm.test('Setup: 선택할 비현재 수단이 존재한다', function () {",
                  "  pm.expect(targetMethod).to.not.equal(undefined);",
                  "});",
                  "",
                  "if (currentMethods.length === 1 && targetMethod) {",
                  "  pm.collectionVariables.set('originalCurrentPaymentMethodId', currentMethods[0].paymentMethodId);",
                  "  pm.collectionVariables.set('targetPaymentMethodId', targetMethod.paymentMethodId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "00 Setup - 다른 고객 결제수단 탐색",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{otherUserId}}", "type": "text" },
              { "key": "X-User-Role", "value": "{{testUserRole}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/subscription/payment-methods",
            "description": "소유권 은닉 실패 시나리오에 사용할 다른 고객의 결제수단을 찾는다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: 다른 고객 목록 조회가 성공한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const methods = body && body.data && Array.isArray(body.data.paymentMethods)",
                  "  ? body.data.paymentMethods",
                  "  : [];",
                  "",
                  "pm.test('Setup: 다른 고객에게 사용 가능한 수단이 존재한다', function () {",
                  "  pm.expect(methods.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "if (methods.length > 0) {",
                  "  pm.collectionVariables.set('otherUserPaymentMethodId', methods[0].paymentMethodId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "01 본인의 다른 결제수단 선택",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}", "type": "text" },
              { "key": "X-User-Role", "value": "{{testUserRole}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/subscription/payment-methods/{{targetPaymentMethodId}}/current",
            "description": "본인의 AVAILABLE 비현재 수단을 현재 수단으로 변경한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('01: HTTP 200을 반환한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('01: 선택한 결제수단을 현재 수단으로 반환한다', function () {",
                  "  pm.expect(body.code).to.eql('00');",
                  "  pm.expect(body.message).to.eql('SUCCESS');",
                  "  pm.expect(body.data.paymentMethodId).to.eql(pm.collectionVariables.get('targetPaymentMethodId'));",
                  "  pm.expect(body.data.isCurrent).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Verify - 현재 수단 변경 결과",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}", "type": "text" },
              { "key": "X-User-Role", "value": "{{testUserRole}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/subscription/payment-methods",
            "description": "변경 후 현재 수단이 정확히 하나이고 기존 수단이 해제됐는지 확인한다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('01 Verify: HTTP 200을 반환한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const methods = pm.response.json().data.paymentMethods;",
                  "const currentMethods = methods.filter(method => method.isCurrent === true);",
                  "const original = methods.find(method => method.paymentMethodId === pm.collectionVariables.get('originalCurrentPaymentMethodId'));",
                  "pm.test('01 Verify: 선택한 수단만 현재 수단이다', function () {",
                  "  pm.expect(currentMethods.length).to.eql(1);",
                  "  pm.expect(currentMethods[0].paymentMethodId).to.eql(pm.collectionVariables.get('targetPaymentMethodId'));",
                  "  pm.expect(original.isCurrent).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 이미 현재인 결제수단 재선택",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}", "type": "text" },
