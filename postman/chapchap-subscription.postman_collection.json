          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('02: HTTP 200을 반환한다', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('02: 같은 결제수단을 현재 수단으로 반환한다', function () {",
                  "  pm.expect(body.code).to.eql('00');",
                  "  pm.expect(body.data.paymentMethodId).to.eql(pm.collectionVariables.get('targetPaymentMethodId'));",
                  "  pm.expect(body.data.isCurrent).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
