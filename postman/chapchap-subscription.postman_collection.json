    {
      "name": "SUB-FN-001",
      "description": "배송지 등록·조회·수정·기본 지정·삭제 검증. 삭제 요청은 활성 구독에서 사용하지 않는 테스트 배송지로 실행한다.",
      "item": [
        {
          "name": "01 배송지 등록",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{testUserId}}" },
              { "key": "X-User-Role", "value": "{{testUserRole}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman 검증 배송지\",\n  \"recipientName\": \"테스트 사용자\",\n  \"recipientPhone\": \"010-0000-0000\",\n  \"postalCode\": \"41911\",\n  \"addressLine1\": \"대구광역시 중구 국채보상로 1\",\n  \"addressLine2\": \"101호\",\n  \"deliveryMethod\": \"DOORSTEP\",\n  \"otherDeliveryRequest\": null,\n  \"entrancePassword\": null\n}" },
            "url": "{{baseUrl}}/api/subscription/addresses"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('배송지 등록 성공', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body.code).to.eql('00');",
            "pm.environment.set('testAddressId', body.data.addressId);"
          ] } }]
        },
        {
          "name": "02 배송지 목록 조회",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}" },
              { "key": "X-User-Role", "value": "{{testUserRole}}" }
            ],
            "url": "{{baseUrl}}/api/subscription/addresses"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('배송지 목록 조회 성공', () => pm.response.to.have.status(200));",
            "const addresses = pm.response.json().data.addresses;",
            "pm.expect(addresses.some(it => it.addressId === pm.environment.get('testAddressId'))).to.eql(true);",
            "const originalDefault = addresses.find(it => it.isDefault && it.addressId !== pm.environment.get('testAddressId'));",
            "if (originalDefault) pm.collectionVariables.set('originalDefaultAddressId', originalDefault.addressId);"
          ] } }]
        },
        {
          "name": "03 배송지 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{testUserId}}" },
              { "key": "X-User-Role", "value": "{{testUserRole}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman 수정 배송지\",\n  \"addressLine2\": null\n}" },
            "url": "{{baseUrl}}/api/subscription/addresses/{{testAddressId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('배송지 수정 성공', () => pm.response.to.have.status(200));",
            "pm.expect(pm.response.json().data.addressId).to.eql(pm.environment.get('testAddressId'));"
          ] } }]
        },
        {
          "name": "04 기본 배송지 지정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}" },
              { "key": "X-User-Role", "value": "{{testUserRole}}" }
            ],
            "url": "{{baseUrl}}/api/subscription/addresses/{{testAddressId}}/default"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('기본 배송지 지정 성공', () => pm.response.to.have.status(200));",
            "pm.expect(pm.response.json().data.addressId).to.eql(pm.environment.get('testAddressId'));"
          ] } }]
        },
        {
          "name": "05 기존 기본 배송지 복원",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}" },
              { "key": "X-User-Role", "value": "{{testUserRole}}" }
            ],
            "url": "{{baseUrl}}/api/subscription/addresses/{{originalDefaultAddressId}}/default"
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "if (!pm.collectionVariables.get('originalDefaultAddressId')) pm.execution.skipRequest();"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('기존 기본 배송지 복원 성공', () => pm.response.to.have.status(200));"
            ] } }
          ]
        },
        {
          "name": "06 테스트 배송지 삭제",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{testUserId}}" },
              { "key": "X-User-Role", "value": "{{testUserRole}}" }
            ],
            "url": "{{baseUrl}}/api/subscription/addresses/{{testAddressId}}"
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "if (!pm.collectionVariables.get('originalDefaultAddressId')) pm.execution.skipRequest();"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('테스트 배송지 삭제 성공', () => pm.response.to.have.status(200));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "SUB-FN-002",
      "description": "현재 비대면 보관 약관 조회 후 같은 버전에 동의한다.",
      "item": [
        {
